{
  "name": "@assetweave/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./profile": {
      "types": "./dist/src/runtime/profile.service.d.ts",
      "default": "./dist/src/runtime/profile.service.js"
    },
    "./main": {
      "types": "./dist/src/main.d.ts",
      "default": "./dist/src/main.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/database/migrations', 'dist/src/database/migrations', { recursive: true })\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"dist/test/*.test.js\"",
    "start": "node dist/src/main.js start",
    "pair": "node dist/src/main.js pair"
  },
  "dependencies": {
    "@assetweave/contracts": "workspace:*",
    "@assetweave/web": "workspace:*",
    "@fastify/multipart": "10.1.2",
    "@fastify/static": "10.1.5",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-fastify": "11.2.6",
    "fastify": "5.11.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  }
}
